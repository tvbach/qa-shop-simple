{
  "name": "qa-shop-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Starter Playwright + TypeScript để kiểm thử QA Shop (API và UI)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
